{
  "expo": {
    "name": "YouTube Buddy",
    "slug": "youtube-buddy",
    "owner": "moinsen_dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youtubebuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.moinsen.youtubebuddy",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "dev.moinsen.youtubebuddy",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.870515903914-8vk5cfiql8nl5imt2g6r3es35s5hrgj7"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "llama.rn",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "google": {
        "webClientId": "870515903914-qmu75gejgjhb6676vvai47ccnkq8g5ar.apps.googleusercontent.com",
        "iosClientId": "870515903914-8vk5cfiql8nl5imt2g6r3es35s5hrgj7.apps.googleusercontent.com"
      },
      "router": {},
      "eas": {
        "projectId": "5bc5555e-6c74-4157-b85e-6a8e4333a29d"
      }
    }
  }
}
